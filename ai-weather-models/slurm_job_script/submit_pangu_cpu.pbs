
#!/bin/bash
#PBS -N pangu_cpu
#PBS -A NAML0001
#PBS -q main
#PBS -l select=1:ncpus=8:mpiprocs=1:ompthreads=128:mem=128GB
#PBS -l walltime=24:00:00
#PBS -j oe
#PBS -k eod

set -euo pipefail

# ----------------------------------------------------------------------
# Pangu-Weather / Earth2Studio CPU batch job on Derecho
# ----------------------------------------------------------------------

BASE=/glade/work/sakor/AI_NWP
SCRIPT=${BASE}/scripts/run_pangu_cpu_forecast.py
OUTPUT_DIR=/glade/derecho/scratch/sakor/bulk/era5_init/pw

START_DATE=2022-03-16
END_DATE=2022-04-01

# ----------------------------------------------------------------------
# Environment
# ----------------------------------------------------------------------

module purge
module load ncarenv

# Activate the same Conda environment used by the working Pangu notebook.
# Notebook kernelspec: Python (Pangu-NWP) / pangu-nwp
source /glade/u/home/sakor/.bashrc
conda activate /glade/work/sakor/conda-envs/pangu-nwp

PYTHON=$(which python)

# ----------------------------------------------------------------------
# CPU thread settings
# ----------------------------------------------------------------------

export OMP_NUM_THREADS=128
export MKL_NUM_THREADS=128
export OPENBLAS_NUM_THREADS=128
export NUMEXPR_NUM_THREADS=128

# ----------------------------------------------------------------------
# Earth2Studio cache locations
#
# ERA5 cache is shared so Pangu, GraphCast, Aurora, etc. can reuse
# already-downloaded initialization data whenever their requested
# variables/times overlap.
# ----------------------------------------------------------------------

export AI_NWP_BASE=${BASE}
export EARTH2STUDIO_MODEL_CACHE=${BASE}/cache/models
export EARTH2STUDIO_DATA_CACHE=${BASE}/cache/era5
export EARTH2STUDIO_PACKAGE_TIMEOUT=3600

# ----------------------------------------------------------------------
# Temporary working directory
# ----------------------------------------------------------------------

export TMPDIR=/glade/derecho/scratch/${USER}/tmp/pangu_${PBS_JOBID}
mkdir -p "${TMPDIR}"

# ----------------------------------------------------------------------
# Required directories
# ----------------------------------------------------------------------

mkdir -p \
    "${OUTPUT_DIR}" \
    "${BASE}/logs/pangu" \
    "${BASE}/cache/models" \
    "${BASE}/cache/era5"

# ----------------------------------------------------------------------
# Job information
# ----------------------------------------------------------------------

echo "======================================================================"
echo "PANGU CPU JOB"
echo "======================================================================"
echo "Job ID       : ${PBS_JOBID}"
echo "Host         : $(hostname)"
echo "Project      : ${PBS_ACCOUNT:-NAML0001}"
echo "Working dir  : ${PBS_O_WORKDIR:-unknown}"
echo "Conda env    : ${CONDA_DEFAULT_ENV:-unknown}"
echo "Python       : ${PYTHON}"
echo "Script       : ${SCRIPT}"
echo "Date range   : ${START_DATE} through ${END_DATE}, inclusive"
echo "Output dir   : ${OUTPUT_DIR}"
echo "ERA5 cache   : ${EARTH2STUDIO_DATA_CACHE}"
echo "OMP threads  : ${OMP_NUM_THREADS}"
echo "Start time   : $(date -u '+%Y-%m-%d %H:%M:%S UTC')"
echo "======================================================================"

# ----------------------------------------------------------------------
# Run forecast batch
# ----------------------------------------------------------------------

${PYTHON} -u "${SCRIPT}" \
    --start "${START_DATE}" \
    --end "${END_DATE}" \
    --output-dir "${OUTPUT_DIR}"

status=$?

# ----------------------------------------------------------------------
# Final job information
# ----------------------------------------------------------------------

echo "======================================================================"
echo "End time     : $(date -u '+%Y-%m-%d %H:%M:%S UTC')"
echo "Exit status  : ${status}"
echo "======================================================================"

rm -rf "${TMPDIR}"

exit ${status}
