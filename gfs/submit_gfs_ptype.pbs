#!/bin/bash
#PBS -N gfs_ptype
#PBS -A NAML0001
#PBS -q main
#PBS -l select=1:ncpus=4:mem=24GB
#PBS -l walltime=04:00:00
#PBS -J 0-127%4
#PBS -j oe

set -euo pipefail


# ============================================================
# PATHS
# ============================================================

WORKDIR="/glade/work/sakor/AI_NWP/gfs"
PYTHON="/glade/work/sakor/conda-envs/mlguess/bin/python"
SCRIPT="${WORKDIR}/gfs_ptype.py"

BASE_DIR="/glade/derecho/scratch/sakor/gfs"
MODEL_PATH="/glade/derecho/scratch/cbecker/ptype_model_20240909.keras"
SCALER_PATH="/glade/derecho/scratch/cbecker/ptype_scaler_20240909.json"


# ============================================================
# INITIALIZATION DATE RANGE
# ============================================================

START_DATE="2021-12-01"
END_DATE="2022-04-01"

INIT_DATE=$(date -d "${START_DATE} +${PBS_ARRAY_INDEX} days" +%Y-%m-%d)

# Safety check
if [[ "$(date -d "${INIT_DATE}" +%s)" -gt "$(date -d "${END_DATE}" +%s)" ]]; then
    echo "Initialization ${INIT_DATE} is beyond ${END_DATE}. Exiting."
    exit 0
fi


# ============================================================
# THREADING
# ============================================================

export OMP_NUM_THREADS=4
export NUMBA_NUM_THREADS=4
export MKL_NUM_THREADS=4
export OPENBLAS_NUM_THREADS=4
export NUMEXPR_NUM_THREADS=4

export TF_NUM_INTRAOP_THREADS=4
export TF_NUM_INTEROP_THREADS=1


# ============================================================
# RUN
# ============================================================

cd "${WORKDIR}"

echo "============================================================"
echo "GFS precipitation-type job"
echo "PBS job ID       : ${PBS_JOBID}"
echo "PBS array index  : ${PBS_ARRAY_INDEX}"
echo "Host             : $(hostname)"
echo "Initialization   : ${INIT_DATE} 00Z"
echo "CPUs             : ${NCPUS:-4}"
echo "Start time       : $(date)"
echo "============================================================"

"${PYTHON}" "${SCRIPT}" \
    --start-date "${INIT_DATE}" \
    --end-date "${INIT_DATE}" \
    --cycle 00 \
    --base-dir "${BASE_DIR}" \
    --model-path "${MODEL_PATH}" \
    --scaler-path "${SCALER_PATH}" \
    --max-workers 4

status=$?

echo "============================================================"
echo "Initialization   : ${INIT_DATE} 00Z"
echo "Exit status      : ${status}"
echo "End time         : $(date)"
echo "============================================================"

exit ${status}