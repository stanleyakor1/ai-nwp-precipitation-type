#!/bin/bash
#PBS -N au_ptype
#PBS -A NAML0001
#PBS -q main
#PBS -l select=1:ncpus=4:mem=80GB
#PBS -l walltime=04:00:00
#PBS -J 0-128%4
#PBS -j oe

set -euo pipefail

# ================================================================
# USER SETTINGS
# ================================================================

START_DATE="2021-11-24"
END_DATE="2022-04-01"

# ================================================================
# PATHS
# ================================================================

PROJECT_DIR="/glade/work/sakor/AI_NWP/ptype"
INPUT_DIR="/glade/derecho/scratch/sakor/bulk/era5_init/aurora"
OUTPUT_DIR="/glade/derecho/scratch/sakor/bulk/era5_init/ML_PTYPE/ac_ptype"

SURFACE_GEOPOTENTIAL="/glade/work/sakor/AI_NWP/ai-weather-models/era5_static_file/e5.oper.invariant.128_129_z.ll025sc.1979010100_1979010100.nc"
EDNN_MODEL="/glade/derecho/scratch/cbecker/ptype_model_20240909.keras"
SCALER="/glade/derecho/scratch/cbecker/ptype_scaler_20240909.json"



# ================================================================
# ENVIRONMENT
# ================================================================

source ~/.bashrc
conda activate /glade/work/sakor/conda-envs/mlguess

export PYTHONPATH="${PROJECT_DIR}:${PYTHONPATH:-}"
export OMP_NUM_THREADS=4
export MKL_NUM_THREADS=4
export OPENBLAS_NUM_THREADS=4
export NUMEXPR_NUM_THREADS=4

PYTHON=$(which python)

# ================================================================
# DETERMINE INITIALIZATION DATE
# ================================================================

INIT_DATE=$(date -d "${START_DATE} +${PBS_ARRAY_INDEX} days" +%Y%m%d)
INIT_LABEL=$(date -d "${START_DATE} +${PBS_ARRAY_INDEX} days" +%Y-%m-%dT00Z)

# Safety check
INIT_DATE_CHECK=$(date -d "${START_DATE} +${PBS_ARRAY_INDEX} days" +%Y-%m-%d)

if [[ "$(date -d "${INIT_DATE_CHECK}" +%s)" -gt "$(date -d "${END_DATE}" +%s)" ]]; then
    echo "Initialization ${INIT_DATE_CHECK} is beyond END_DATE=${END_DATE}; exiting."
    exit 0
fi

INPUT_FILE="${INPUT_DIR}/aurora_${INIT_DATE}_00z_168h.nc"

# ================================================================
# JOB INFORMATION
# ================================================================

echo "======================================================================"
echo "GRAPHCAST PTYPE POSTPROCESSING"
echo "======================================================================"
echo "Job ID         : ${PBS_JOBID}"
echo "Array index    : ${PBS_ARRAY_INDEX}"
echo "Host           : $(hostname)"
echo "Python         : ${PYTHON}"
echo "Requested range: ${START_DATE} through ${END_DATE}"
echo "Initialization : ${INIT_LABEL}"
echo "Input file     : ${INPUT_FILE}"
echo "Output dir     : ${OUTPUT_DIR}"
echo "Start time     : $(date -u '+%Y-%m-%d %H:%M:%S UTC')"
echo "======================================================================"

# ================================================================
# VERIFY INPUT
# ================================================================

if [[ ! -f "${INPUT_FILE}" ]]; then
    echo "ERROR: Input file not found:"
    echo "${INPUT_FILE}"
    exit 1
fi

# ================================================================
# RUN PTYPE PIPELINE
# ================================================================

"${PYTHON}" -u "${PROJECT_DIR}/scripts/run_ptype.py" \
    --input "${INPUT_FILE}" \
    --model-name aurora \
    --surface-geopotential "${SURFACE_GEOPOTENTIAL}" \
    --ednn-model "${EDNN_MODEL}" \
    --scaler "${SCALER}" \
    --output-dir "${OUTPUT_DIR}"

status=$?

# ================================================================
# FINAL STATUS
# ================================================================

echo "======================================================================"
echo "Initialization : ${INIT_LABEL}"
echo "End time       : $(date -u '+%Y-%m-%d %H:%M:%S UTC')"
echo "Exit status    : ${status}"
echo "======================================================================"

exit "${status}"
