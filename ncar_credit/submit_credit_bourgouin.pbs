#!/bin/bash
#PBS -N wxf_bourg
#PBS -A NAML0001
#PBS -q main
#PBS -l select=1:ncpus=1:mem=16GB
#PBS -l walltime=04:00:00
#PBS -J 0-127%4
#PBS -j oe

set -euo pipefail


# ============================================================
# PATHS
# ============================================================

WORKDIR="/glade/work/sakor/AI_NWP/ncar_credit"

PYTHON="/glade/work/sakor/conda-envs/mlguess/bin/python"

SCRIPT="${WORKDIR}/wxformer_bourgouin.py"


# ============================================================
# DATE RANGE
# ============================================================

START_DATE="2021-11-24"
END_DATE="2022-03-31"

# One initialization per PBS array task
INIT_DATE=$(date -d "${START_DATE} +${PBS_ARRAY_INDEX} days" +%Y-%m-%d)

# Safety check
if [[ "$(date -d "${INIT_DATE}" +%s)" -gt "$(date -d "${END_DATE}" +%s)" ]]; then
    echo "Initialization ${INIT_DATE} is beyond END_DATE=${END_DATE}. Exiting."
    exit 0
fi


# ============================================================
# THREADING
# ============================================================

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1


# ============================================================
# RUN
# ============================================================

cd "${WORKDIR}"

echo "============================================================"
echo "WXFormer Bourgouin processing"
echo "PBS job ID       : ${PBS_JOBID}"
echo "PBS array index  : ${PBS_ARRAY_INDEX}"
echo "Host             : $(hostname)"
echo "Initialization   : ${INIT_DATE} 00Z"
echo "Start time       : $(date)"
echo "Python           : ${PYTHON}"
echo "Script           : ${SCRIPT}"
echo "============================================================"

"${PYTHON}" "${SCRIPT}" \
    --start-date "${INIT_DATE}" \
    --end-date "${INIT_DATE}"

status=$?

echo "============================================================"
echo "Initialization   : ${INIT_DATE} 00Z"
echo "Exit status      : ${status}"
echo "End time         : $(date)"
echo "============================================================"

exit ${status}
